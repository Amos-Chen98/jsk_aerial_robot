<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="dragon_common" >

  <!--  model type 1: head-->
  <!--  model type 2: baselink (attached with imu, pc)-->
  <!--  model type 3: general -->
  <!--  model type 4: end -->

  <!-- general attribute -->
  <baselink name="fc" />
  <thrust_link name="thrust" />
  
  <!-- kinematics [m] -->
  <xacro:property name="link_length" value=".474" />
  <xacro:property name="inter_joint_x_offset" value=".02575" />
  <xacro:property name="gimbal_roll_x_offset" value="-0.0065" />
  <xacro:property name="gimbal_pitch_z_offset" value="0.0265" />

  <!-- collision geometry [m] -->
  <xacro:property name="link_collision_length" value="0.60" />
  <xacro:property name="link_collision_width" value="0.13" />
  <xacro:property name="link_collision_height" value="0.19" />
  <xacro:property name="link_collision_y_offset" value="-0.017" />
  <xacro:property name="link_collision_z_offset" value="0.005" />

  <!-- dynamics -->
  <m_f_rate value="0" /> <!-- drug torque rate -->
  <xacro:property name="max_force" value="30" /> <!-- [N] -->
  <xacro:property name="min_force" value="2" /> <!-- [N] -->

  <xacro:macro name="link_model" params="type">

    <!-- box collision geometry does not work well for FCL -->
    <collision>
    <origin rpy="0 0 0" xyz="${link_length* 0.5} ${link_collision_y_offset} ${link_collision_z_offset}"/>
    <geometry>
    <box size="${link_collision_length} ${link_collision_width} ${link_collision_height}"/>
    </geometry>
    </collision>

    <visual>
      <origin rpy="0 0 0" xyz="${link_length* 0.5} 0 0"/>
      <geometry>
        <mesh filename="package://dragon/urdf/v1_5/mesh/${type}.stl"/>
      </geometry>
    </visual>
  </xacro:macro>

  <xacro:macro name="extra_module" params="name parent *origin *inertial visible:=0 model_url:=1 scale:=1 visual_x:=0 visual_y:=0 visual_z:=0 visual_roll:=0 visual_pitch:=0 visual_yaw:=0">
    <joint name="${parent}2${name}" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <xacro:insert_block name="origin" />
    </joint>
    <link name="${name}">
      <xacro:insert_block name="inertial" />
      <xacro:if value="${visible == 1}">
        <visual>
          <origin rpy="${visual_roll} ${visual_pitch} ${visual_yaw}" xyz="${visual_x} ${visual_y} ${visual_z}"/>
          <geometry>
            <mesh filename="${model_url}" scale= "${scale} ${scale} ${scale}"/>
          </geometry>
        </visual>
      </xacro:if>
    </link>
  </xacro:macro>

  <!-- friction -->
  <xacro:macro name="friction" params="self">
    <gazebo reference="link${self}">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="damping_factor" params="link">
    <gazebo reference="${link}">
      <dampingFactor>0.00</dampingFactor>
    </gazebo>
  </xacro:macro>
</robot>
